# Local development settings for docker-compose.yml. Copy to .env (gitignored) and fill in.
# Generate secrets, for example with:  openssl rand -hex 32   /   openssl rand -hex 64

# PostgreSQL password of the local database container (required).
POSTGRES_PASSWORD=

# Rails secret; also the key material for DocuSeal's encrypted columns (webhook URLs and
# secrets, API tokens, e-signature certificates). Keep it stable - changing it makes the
# stored encrypted data unreadable (required, 128 hex characters recommended).
SECRET_KEY_BASE=

# Public base URL; used in API responses (embed_src, document URLs), webhooks and emails.
APP_URL=http://localhost:3080

# Host port the app is published on (127.0.0.1 only).
APP_PORT=3080

# Any non-empty value except "false" enables HTTPS-only mode (HSTS, secure cookies).
# Leave empty for plain HTTP on localhost.
FORCE_SSL=

# Commit baked into the image for the AGPL source link (optional for local builds).
SOURCE_REVISION=
